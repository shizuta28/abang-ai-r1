# Copy this file to .env and fill in real values.
# Never commit .env. Do not put live keys in source files.

NODE_ENV=development
PORT=4000
PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
CORS_ORIGIN=http://localhost:3000

# At least 32 random characters. Example generation:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
COOKIE_SECURE=false

# postgres | hyperdrive | d1
DATABASE_PROVIDER=postgres

# Direct PostgreSQL (local Docker or a hosted Postgres).
DATABASE_URL=postgresql://abang:change-me@localhost:5432/abang

# Hyperdrive speaks the Postgres wire protocol. Use this instead of DATABASE_URL
# when DATABASE_PROVIDER=hyperdrive. Run Prisma migrations against the origin
# database, then point the app at the Hyperdrive connection string.
HYPERDRIVE_DATABASE_URL=

# Cloudflare D1 HTTP API. Used only when DATABASE_PROVIDER=d1.
# Apply database/d1/schema.sql with Wrangler, then set these values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Optional password admin created by npm run db:seed.
# Google accounts listed here become admins after a verified Google login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_EMAILS=

# Google OAuth. Authorized redirect URI must match exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ToyyibPay. Use the sandbox host until the category is live.
# Callback must be a public HTTPS URL that reaches POST /api/payments/toyyibpay/callback.
TOYYIBPAY_USER_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com
TOYYIBPAY_RETURN_URL=http://localhost:3000/checkout/return
TOYYIBPAY_CALLBACK_URL=
TOYYIBPAY_CHANNEL=2

# Strapi. Articles, lessons, and learning resources are read from here.
STRAPI_URL=
STRAPI_API_TOKEN=

# Cloudflare R2. Private bucket. The API uploads files and returns signed URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Meta Threads. Drafts, review, and scheduling work without these.
# Publishing calls the Threads API only when both values are set.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
